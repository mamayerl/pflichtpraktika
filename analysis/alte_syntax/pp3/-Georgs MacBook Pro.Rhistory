lbs.mehr[[2]][7:11,] %>% mutate(newvar = paste0(newvar, " (Teil 2)")),# %>% unlist %>% as.vector,
lbs.mehr[[3]][1:6,] %>% mutate(newvar = paste0(newvar, " (Teil 1)")),# %>% unlist %>% as.vector,
