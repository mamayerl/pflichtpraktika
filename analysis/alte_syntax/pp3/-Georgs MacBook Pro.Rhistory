# q17
y[[1]] %>%
select(1:2, 3:8, (ncol(.)-1):(ncol(.))),
y[[1]] %>%
select(1:2, 9:13, (ncol(.)-1):(ncol(.))),
# q23
y[[2]] %>%
select(1:2, 3:9, (ncol(.)-1):(ncol(.))),
y[[2]] %>%
select(1:2, 10:15, (ncol(.)-1):(ncol(.))),
# q45
y[[3]] %>%
select(1:2, 3:7, (ncol(.)):(ncol(.))),
y[[3]] %>%
select(1:2, 8:12, (ncol(.)):(ncol(.)))
)
